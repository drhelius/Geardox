{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Geardox: debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/hello.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:geardox.gdb}",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "stopAtEntry": false,
            "setupCommands": [
                { "text": "set pagination off" }
            ],
            "preLaunchTask": "Geardox: gdb"
        }
    ]
}
