[geardox]
version = 1

[game]
name = Dungeon Keeper Gold: Deeper Dungeons
folder = C:\

[run]
exe = DEEPER.EXE
setup = SOUND\SETSOUND.EXE

[machine]
model = pentium_90
ram_mb = 32

[autoexec]
IF NOT EXIST KEEPER.CFG ECHO INSTALL_PATH=C:\>KEEPER.TMP
IF NOT EXIST KEEPER.CFG ECHO INSTALL_TYPE=MAX>>KEEPER.TMP
IF NOT EXIST KEEPER.CFG ECHO LANGUAGE=ENG>>KEEPER.TMP
IF EXIST KEEPER.TMP REN KEEPER.TMP KEEPER.CFG
