[geardox]
version = 1

[game]
name = Grand Theft Auto
folder = C:\

[run]
exe = gtados\GTA8.EXE
voodoo_exe = gtados\GTAFX.EXE
setup_exe = gtados\K.EXE

[machine]
model = pentium_133
ram_mb = 16

[autoexec]
IF NOT EXIST GTADOS\DIG.INI ECHO DEVICE      Creative Labs Sound Blaster 16 or AWE32>GTADOS\DIG.TMP
IF NOT EXIST GTADOS\DIG.INI ECHO DRIVER      SB16.DIG>>GTADOS\DIG.TMP
IF NOT EXIST GTADOS\DIG.INI ECHO IO_ADDR     220h>>GTADOS\DIG.TMP
IF NOT EXIST GTADOS\DIG.INI ECHO IRQ         -1>>GTADOS\DIG.TMP
IF NOT EXIST GTADOS\DIG.INI ECHO DMA_8_BIT   -1>>GTADOS\DIG.TMP
IF NOT EXIST GTADOS\DIG.INI ECHO DMA_16_BIT  -1>>GTADOS\DIG.TMP
IF EXIST GTADOS\DIG.TMP REN GTADOS\DIG.TMP DIG.INI
