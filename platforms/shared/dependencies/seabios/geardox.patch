+static int
+floppy_format_init(struct disk_op_s *op)
+{
+    floppy_changeline(op);
+    struct drive_s *drive_gf = op->drive_fl;
+    u8 floppyid = GET_GLOBALFLAT(drive_gf->cntl_id);
+    if (GET_BDA(floppy_media_state[floppyid]) & FMS_MEDIA_DRIVE_ESTABLISHED)
+        return DISK_RET_SUCCESS;
+    u8 ftype = GET_GLOBALFLAT(drive_gf->floppy_type);
+    u8 data_rate = ftype == 1 ? FLOPPY_RATE_250K
+        : GET_GLOBAL(FloppyInfo[ftype].data_rate);
+    return floppy_establish(drive_gf, ftype, data_rate);
