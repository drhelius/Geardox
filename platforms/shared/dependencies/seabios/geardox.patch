+        // the ports they use. The code is 32-bit, relocatable, and ends in a near return
+        DECLFUNC cirrus_pmi
+cirrus_pmi:
+        .word cirrus_pmi_window - cirrus_pmi
+        .word cirrus_pmi_start - cirrus_pmi
+        .word cirrus_pmi_palette - cirrus_pmi
+        .word cirrus_pmi_ports - cirrus_pmi
+        .code32
+        // BL window, DX position in granules
+cirrus_pmi_window:
+        movb %bl, %al
+        addb $0x09, %al
+        movb %dl, %ah
+        movw $0x3ce, %dx
+        outw %ax, %dx
+        ret
+        // BL 00h or 80h to wait for retrace, DX:CX the CRTC start address: CR0D, CR0C, and CR1B bits 0, 2 and 3
+cirrus_pmi_start:
+        shll $16, %edx
+        movw %cx, %dx
+        movl %edx, %ecx
+        testb $0x80, %bl
+        jz 3f
+        movw $0x3da, %dx
+1:      inb %dx, %al
+        testb $0x08, %al
+        jnz 1b
+2:      inb %dx, %al
+        testb $0x08, %al
+        jz 2b
+3:      movw $0x3d4, %dx
+        movb $0x0d, %al
+        movb %cl, %ah
+        outw %ax, %dx
+        movb $0x0c, %al
+        movb %ch, %ah
+        outw %ax, %dx
+        movb $0x1b, %al
+        outb %al, %dx
+        incw %dx
+        inb %dx, %al
+        andb $0xf2, %al
+        shrl $16, %ecx
+        movb %cl, %ah
+        andb $0x01, %ah
+        orb %ah, %al
+        movb %cl, %ah
+        shlb $1, %ah
+        andb $0x0c, %ah
+        orb %ah, %al
+        outb %al, %dx
+        ret
+        // BL 00h or 80h to wait for retrace, ECX entries from EDX, ES:EDI blue, green, red, unused
+cirrus_pmi_palette:
+        pushl %ecx
+        pushl %edx
+        testb $0x80, %bl
+        jz 3f
+        movw $0x3da, %dx
+1:      inb %dx, %al
+        testb $0x08, %al
+        jnz 1b
+2:      inb %dx, %al
+        testb $0x08, %al
+        jz 2b
+3:      popl %eax
+        popl %ecx
+        movw $0x3c8, %dx
+        outb %al, %dx
+        incw %dx
+        jecxz 5f
+4:      movb %es:2(%edi), %al
+        outb %al, %dx
+        movb %es:1(%edi), %al
+        outb %al, %dx
+        movb %es:(%edi), %al
+        outb %al, %dx
+        addl $4, %edi
+        loop 4b
+5:      ret
+        .code16
+cirrus_pmi_ports:
+        .word 0x3c8, 0x3c9, 0x3ce, 0x3cf, 0x3d4, 0x3d5, 0x3da, 0xffff, 0xffff
+        .global cirrus_pmi_end
+cirrus_pmi_end:
