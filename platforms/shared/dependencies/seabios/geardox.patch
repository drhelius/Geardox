+    outb((romlast - BUILD_ROM_START) >> 12, GEARDOX_SHADOW_PORT);
+    outb((rommax - BUILD_ROM_START) >> 12, GEARDOX_SHADOW_PORT + 1);
+    outb(lock, GEARDOX_SHADOW_PORT + 2);
