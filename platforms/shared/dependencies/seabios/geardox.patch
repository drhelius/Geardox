+// INT 13h AH=16h: the change line of the drive, selected with its motor on
+static int
+floppy_changeline(struct disk_op_s *op)
+{
+    u8 ftype = GET_GLOBALFLAT(op->drive_fl->floppy_type);
+    u8 floppyid = GET_GLOBALFLAT(op->drive_fl->cntl_id);
+    if (!floppy_has_changeline(ftype))
+        return DISK_RET_ECHANGED;
+    if (!(floppy_dor_read() & FLOPPY_DOR_RESET)) {
+        int ret = floppy_enable_controller();
+        if (ret)
+            return ret;
+    }
+    SET_BDA(floppy_motor_counter, 255);
+    floppy_dor_write((FLOPPY_DOR_MOTOR_A << floppyid) | FLOPPY_DOR_IRQ
+                     | FLOPPY_DOR_RESET | floppyid);
+    u8 changed = inb(PORT_FD_DIR) & FLOPPY_DIR_DSKCHG;
+    SET_BDA(floppy_motor_counter, FLOPPY_MOTOR_TICKS);
+    if (!changed)
+        return DISK_RET_SUCCESS;
+    SET_BDA(floppy_media_state[floppyid], 0);
+    return DISK_RET_ECHANGED;
+}
