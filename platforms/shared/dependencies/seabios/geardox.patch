+// IBM 5170 BIOS (11/15/85) listing p5-165, p5-166: TEST_CORD
+static u16
+joystick_read_axis(u8 mask)
+{
+    u16 count = 0;
+    u16 left = 0x4ff;
+    u8 value;
+
+    u16 start = joystick_timer_read();
+    outb(0x00, PORT_GAME);
+    do {
+        value = inb(PORT_GAME);
+        left--;
+    } while (left && (value & mask));
+    if (left) {
+        u16 end = joystick_timer_read();
+        count = (start >= end) ? start - end : start + (0xffff - end);
+        count = (count & 0x1ff0) >> 4;
+    }
+
+    left = 0x4ff;
+    do {
+        value = inb(PORT_GAME);
+        left--;
+    } while (left && (value & 0x0f));
+    return count;
+}
