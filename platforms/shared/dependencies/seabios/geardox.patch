+// Geardox: a CGA has no ROM of its own. Its INT 10h code comes as a file, goes past the space an EGA or VGA ROM
+// takes and is entered from F000:F065, where an AT keeps its video BIOS, so nothing answers at C000:0000
+#define GEARDOX_CGA_BIOS_FILE "opt/geardox/cgabios.bin"
+#define GEARDOX_CGA_BIOS_START 0xc8000
+
+static void
+geardox_cga_setup(void)
+{
+    struct romfile_s *file = romfile_find(GEARDOX_CGA_BIOS_FILE);
+    if (!file || rom_get_last() != BUILD_ROM_START)
+        return;
+    rom_skip(GEARDOX_CGA_BIOS_START);
+    struct rom_header *rom = deploy_romfile(file);
+    if (!rom || init_optionrom(rom, 0, 1))
+        return;
+    struct segoff_s entry = GET_IVT(0x10);
+    u8 *stub = (void*)(BUILD_BIOS_ADDR + FUNC16(entry_10).offset);
+    stub[0] = 0xea;
+    *(u16*)&stub[1] = entry.offset;
+    *(u16*)&stub[3] = entry.seg;
+    SET_IVT(0x10, FUNC16(entry_10));
+    VgaROM = rom;
+    dprintf(1, "CGA video BIOS at %p, entered from %04x:%04x\n", rom
+            , FUNC16(entry_10).seg, FUNC16(entry_10).offset);
+}
