+int
+cga_setup(void)
+{
+    return 0;
+}
+
+int
+cga_get_linelength(struct vgamode_s *curmode_g)
+{
+    int width = GET_GLOBAL(curmode_g->width);
+    if (GET_GLOBAL(curmode_g->memmodel) == MM_TEXT)
+        return width * 2;
+    return width * GET_GLOBAL(curmode_g->depth) / 8;
+}
+
+// R12 and R13 are write only: the BIOS data keeps the page's start
+int
+cga_get_displaystart(struct vgamode_s *curmode_g)
+{
+    return GET_BDA(video_pagestart);
+}
+
+// The 6845 counts characters, two bytes each (AT p380)
+int
+cga_set_displaystart(struct vgamode_s *curmode_g, int val)
+{
+    val /= 2;
+    cga_crtc_write(0x0c, val >> 8);
+    cga_crtc_write(0x0d, val);
+    return 0;
+}
+
+// The start and end lines go to R10 and R11 as the caller gives them (AT p376)
+void
+cga_set_cursor_shape(u16 cursor_type)
+{
+    cga_crtc_write(0x0a, cursor_type >> 8);
+    cga_crtc_write(0x0b, cursor_type);
+}
+
+void
+cga_set_cursor_pos(int address)
+{
+    address /= 2;
+    cga_crtc_write(0x0e, address >> 8);
+    cga_crtc_write(0x0f, address);
+}
+
+// INT 10h AH=0Bh: BH=0 puts BL bits 4-0 in 3D9h, BH=1 BL bit 0 in its palette bit 5 (AT p376, p380)
+void
+cga_set_color(u8 id, u8 value)
+{
+    u8 color = GET_BDA(video_pal);
+    if (id == 0)
+        color = (color & 0xe0) | (value & 0x1f);
+    else
+        color = (color & 0xdf) | ((value & 0x01) << 5);
+    SET_BDA(video_pal, color);
+    outb(color, VGAREG_CGA_PALETTE);
+}
