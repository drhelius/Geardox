+// Geardox's board has no PCI bridge: a shadow register at port 404h, which reads back "GDOX". Writes give the end of
+// the option ROMs and of the free space below the low zone, in 4 KB pages from 0xc0000, and then lock or unlock;
+// port 407h gives the start of the option ROMs, with free space below them too.
+// Locked, the ROMs and the 0xf0000 segment are read-only, the free space has nothing there for UMB managers and the
+// low zone stays writable
+#define GEARDOX_SHADOW_PORT 0x404
+#define GEARDOX_SHADOW_ID 0x584f4447
+
+static int
+geardox_shadow(void)
+{
+    return inl(GEARDOX_SHADOW_PORT) == GEARDOX_SHADOW_ID;
+}
+
+static void
+geardox_shadow_lock(int lock)
+{
+    u32 romlast = ALIGN(rom_get_last(), 4096), rommax = BUILD_BIOS_ADDR;
+    if (CONFIG_MALLOC_UPPERMEMORY)
+        rommax = ALIGN_DOWN(rom_get_max(), 4096);
+    if (romlast > rommax)
+        romlast = rommax;
+    u32 romfirst = ALIGN_DOWN(rom_get_first(), 4096);
+    outb((romlast - BUILD_ROM_START) >> 12, GEARDOX_SHADOW_PORT);
+    outb((rommax - BUILD_ROM_START) >> 12, GEARDOX_SHADOW_PORT + 1);
+    outb((romfirst - BUILD_ROM_START) >> 12, GEARDOX_SHADOW_PORT + 3);
+    outb(lock, GEARDOX_SHADOW_PORT + 2);
+}
