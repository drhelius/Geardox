+    u8 rate = 0;
+    int stype = floppy_find_media(drive_fl, cylinders, regs->cl & 0x3f, &rate);
+    if (!stype) {
+        disk_ret(regs, DISK_RET_EBADTRACK);
+        return;
+    }
+    disk_set_media(regs, drive_fl, stype, rate);
+}
