+// R0-R15 for 40-column text, 80-column text and graphics, as IBM programs them (OPT2 p58, AT p425-p426)
+static u8 cga_crtc_40[] VAR16 = {
+    0x38, 0x28, 0x2d, 0x0a, 0x1f, 0x06, 0x19, 0x1c,
+    0x02, 0x07, 0x06, 0x07, 0x00, 0x00, 0x00, 0x00 };
+static u8 cga_crtc_80[] VAR16 = {
+    0x71, 0x50, 0x5a, 0x0a, 0x1f, 0x06, 0x19, 0x1c,
+    0x02, 0x07, 0x06, 0x07, 0x00, 0x00, 0x00, 0x00 };
+static u8 cga_crtc_graphics[] VAR16 = {
+    0x38, 0x28, 0x2d, 0x0a, 0x7f, 0x06, 0x64, 0x70,
+    0x02, 0x01, 0x06, 0x07, 0x00, 0x00, 0x00, 0x00 };
+
+struct cga_mode_s {
+    u16 mode;
+    struct vgamode_s info;
+    u8 *crtc_regs;
+    u8 modereg;
+};
+
+// The mode register takes the AT's table M7 (AT p426)
+static struct cga_mode_s cga_modes[] VAR16 = {
+    //mode { model       tx   ty bpp cw ch  sstart    }  crtc  mode
+    {0x00, { MM_TEXT,    40,  25, 4, 8,  8, SEG_CTEXT }, cga_crtc_40, 0x2c},
+    {0x01, { MM_TEXT,    40,  25, 4, 8,  8, SEG_CTEXT }, cga_crtc_40, 0x28},
+    {0x02, { MM_TEXT,    80,  25, 4, 8,  8, SEG_CTEXT }, cga_crtc_80, 0x2d},
+    {0x03, { MM_TEXT,    80,  25, 4, 8,  8, SEG_CTEXT }, cga_crtc_80, 0x29},
+    {0x04, { MM_CGA,    320, 200, 2, 8,  8, SEG_CTEXT }, cga_crtc_graphics, 0x2a},
+    {0x05, { MM_CGA,    320, 200, 2, 8,  8, SEG_CTEXT }, cga_crtc_graphics, 0x2e},
+    {0x06, { MM_CGA,    640, 200, 1, 8,  8, SEG_CTEXT }, cga_crtc_graphics, 0x1e},
+};
+
+static int
+is_cga_mode(struct vgamode_s *vmode_g)
+{
+    return (vmode_g >= &cga_modes[0].info
+            && vmode_g <= &cga_modes[ARRAY_SIZE(cga_modes)-1].info);
+}
+
+struct vgamode_s *
+cga_find_mode(int mode)
+{
+    int i;
+    for (i = 0; i < ARRAY_SIZE(cga_modes); i++) {
+        struct cga_mode_s *cmode_g = &cga_modes[i];
+        if (GET_GLOBAL(cmode_g->mode) == mode)
+            return &cmode_g->info;
+    }
+    return NULL;
+}
+
+static void
+cga_crtc_write(u8 index, u8 value)
+{
+    outb(index, VGAREG_VGA_CRTC_ADDRESS);
+    outb(value, VGAREG_VGA_CRTC_DATA);
+}
+
+// Video off, the 6845 loaded and memory cleared, then the mode and color registers, as the AT's SET_MODE does; the
+// BIOS data keeps 3D8h and 3D9h, which can't be read back. 3D9h is 30h, or 3Fh in 640x200 (AT p253, p378-p379)
+int
+cga_set_mode(struct vgamode_s *vmode_g, int flags)
+{
+    if (!is_cga_mode(vmode_g))
+        return -1;
+    struct cga_mode_s *cmode_g = container_of(vmode_g, struct cga_mode_s, info);
+    u8 modereg = GET_GLOBAL(cmode_g->modereg);
+    outb(modereg & 0x37, VGAREG_CGA_MODECTL);
+
+    u8 *regs = GET_GLOBAL(cmode_g->crtc_regs);
+    int i;
+    for (i = 0; i < 16; i++)
+        cga_crtc_write(i, GET_GLOBAL(regs[i]));
+
+    if (GET_GLOBAL(vmode_g->memmodel) == MM_TEXT)
+        memset16_far(SEG_CTEXT, 0, 0x0720, 16*1024);
+    else
+        memset16_far(SEG_CTEXT, 0, 0x0000, 16*1024);
+
+    u8 color = GET_GLOBAL(vmode_g->width) == 640 ? 0x3f : 0x30;
+    outb(modereg, VGAREG_CGA_MODECTL);
+    outb(color, VGAREG_CGA_PALETTE);
+    SET_BDA(video_msr, modereg);
+    SET_BDA(video_pal, color);
+    return 0;
+}
