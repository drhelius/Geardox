+// The media to format is known, so no sensing is needed
+static int
+floppy_establish(struct drive_s *drive_gf, u8 stype, u8 data_rate)
+{
+    u8 ftype = GET_GLOBALFLAT(drive_gf->floppy_type);
+    u8 floppyid = GET_GLOBALFLAT(drive_gf->cntl_id);
+    int ret = floppy_drive_recal(floppyid);
+    if (ret)
+        return ret;
+    ret = floppy_check_media(drive_gf, floppyid);
+    if (ret)
+        return ret;
+    ret = floppy_drive_specify();
+    if (ret)
+        return ret;
+    outb(data_rate, PORT_FD_DIR);
+    floppy_set_state(floppyid, ftype, stype, data_rate);
+    return DISK_RET_SUCCESS;
+}
+
+// INT 13h AH=17h and 18h
+static int
+floppy_set_media(struct disk_op_s *op)
+{
+    return floppy_establish(op->drive_fl, op->lba & 0xff
+                            , (op->lba >> 8) & 0xff);
+}
+
+// The FloppyInfo row and rate for a size asked by AH=18h, 0 when the drive can't
+int
+floppy_find_media(struct drive_s *drive_gf, u16 cylinders, u8 sectors, u8 *rate)
+{
+    u8 ftype = GET_GLOBALFLAT(drive_gf->floppy_type);
+    int stype;
+    for (stype=1; stype<ARRAY_SIZE(FloppyInfo); stype++) {
+        if (GET_GLOBAL(FloppyInfo[stype].chs.cylinder) != cylinders
+            || GET_GLOBAL(FloppyInfo[stype].chs.sector) != sectors
+            || GET_GLOBAL(FloppyInfo[stype].floppy_size)
+               != GET_GLOBAL(FloppyInfo[ftype].floppy_size)
+            || cylinders > GET_GLOBAL(FloppyInfo[ftype].chs.cylinder)
+            || sectors > GET_GLOBAL(FloppyInfo[ftype].chs.sector)
+            || GET_GLOBAL(FloppyInfo[stype].chs.head) != 2)
+            continue;
+        *rate = GET_GLOBAL(FloppyInfo[stype].data_rate);
+        if (ftype == 1)
+            *rate = FLOPPY_RATE_250K;
+        return stype;
+    }
+    return 0;
+}
+
+// The FloppyInfo row and rate for a type asked by AH=17h, 0 when it's invalid
+int
+floppy_find_type(struct drive_s *drive_gf, u8 type, u8 *rate)
+{
+    switch (type) {
+    case 1:
+        *rate = FLOPPY_RATE_250K;
+        return 1;
+    case 2:
+        *rate = FLOPPY_RATE_300K;
+        return 1;
+    case 3:
+        *rate = FLOPPY_RATE_500K;
+        return 2;
+    case 4:
+        *rate = GET_GLOBALFLAT(drive_gf->floppy_type) == 2
+            ? FLOPPY_RATE_300K : FLOPPY_RATE_250K;
+        return 3;
+    }
+    return 0;
+}
