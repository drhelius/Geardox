+static void
+disk_set_media(struct bregs *regs, struct drive_s *drive_fl, int stype, u8 rate)
+{
+    struct disk_op_s dop;
+    dop.drive_fl = drive_fl;
+    dop.command = CMD_SETMEDIA;
+    dop.lba = stype | (rate << 8);
+    dop.count = 0;
