+static u16
+joystick_timer_read(void)
+{
+    outb(0x00, PORT_PIT_MODE);
+    u8 lo = inb(PORT_PIT_COUNTER0);
+    return lo | (inb(PORT_PIT_COUNTER0) << 8);
