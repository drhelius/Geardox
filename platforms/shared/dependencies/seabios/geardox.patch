+static u16
+joystick_timer_read(void)
+{
+    outb(0x00, PORT_PIT_MODE);
+    u8 lo = inb(PORT_PIT_COUNTER0);
+    return lo | (inb(PORT_PIT_COUNTER0) << 8);
+}
+
+// IBM 5170 BIOS (11/15/85) listing p5-165, p5-166: TEST_CORD
+static u16
+joystick_read_axis(u8 mask)
+{
+    u16 count = 0;
+    u16 left = 0x4ff;
+    u8 value;
+
+    u16 start = joystick_timer_read();
+    outb(0x00, PORT_GAME);
+    do {
+        value = inb(PORT_GAME);
+        left--;
+    } while (left && (value & mask));
+    if (left) {
+        u16 end = joystick_timer_read();
+        count = (start >= end) ? start - end : start + (0xffff - end);
+        count = (count & 0x1ff0) >> 4;
+    }
+
+    left = 0x4ff;
+    do {
+        value = inb(PORT_GAME);
+        left--;
+    } while (left && (value & 0x0f));
+    return count;
+}
+
+// IBM 5170 BIOS (11/15/85) listing p5-165: JOY_STICK. IBM enables interrupts, but a SeaBIOS handler can't take
+// one on its stack, so the timer tick waits for the return
+static void
+handle_1584(struct bregs *regs)
+{
+    int present = GET_BDA(equipment_list_flags) & 0x1000;
+    regs->ax = regs->dx;
+    switch (regs->al) {
+    case 0x00:
+        regs->al = present ? inb(PORT_GAME) & 0xf0 : 0;
+        set_success(regs);
+        break;
+    case 0x01:
+        regs->ax = present ? joystick_read_axis(0x01) : 0;
+        regs->bx = present ? joystick_read_axis(0x02) : 0;
+        regs->cx = present ? joystick_read_axis(0x04) : 0;
+        regs->dx = present ? joystick_read_axis(0x08) : 0;
+        set_success(regs);
+        break;
+    default:
+        regs->al--;
+        set_invalid_silent(regs);
+        break;
+    }
+}
